<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Link not found</title>
<link rel="stylesheet" href="/interstitial.css">
</head>
<body>
<main class="stage">
  <div style="text-align:center;max-width:34ch">
    <h1 class="download__title" style="max-width:none">Link not found</h1>
    <p style="color:var(--ink-muted)"><%= reason %></p>
    <% if (slug) { %>
    <p style="color:var(--ink-muted);font-size:13px">Requested app: <code><%= slug %></code></p>
    <% } %>
  </div>
</main>
</body>
</html>
