{
  "name": "runloyal-link-service",
  "version": "0.1.0",
  "private": true,
  "description": "Native deep-link service (iOS Universal Links + Android App Links) replacing Branch.io",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin:dev": "vite --config admin/vite.config.js",
    "admin:build": "vite build --config admin/vite.config.js",
    "build": "npm run admin:build",
    "build:static": "node scripts/build-static.js",
    "migrate:supabase": "node scripts/migrate-supabase.mjs",
    "deploy": "npm run build:static && npm test && firebase deploy --only hosting",
    "verify": "bash scripts/verify.sh",
    "test": "node scripts/test-boot.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}