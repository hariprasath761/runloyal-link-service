# Copy to .env and fill in.

# Port the Express server listens on.
PORT=3000

# The public HTTPS hostname this service is reachable at — the value that gets
# baked into the app binaries (iOS entitlements + Android manifest pathPrefix).
#
# MUST be a stable hostname. See README §Hosting: use a NAMED Cloudflare Tunnel,
# not a quick tunnel and not ngrok's free tier (which injects an HTML warning
# page that breaks Apple's AASA fetch).
#
# This is also what the interstitial's QR code encodes, so it has to be the
# public host rather than localhost even during local development.
LINK_HOST=link-poc.example.com

# Supabase Auth project settings and the comma-separated accounts allowed into
# the admin portal. Create these users under Supabase Authentication > Users.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ADMIN_EMAILS=admin@example.com

# Supabase Postgres connection. Keep these server-side only.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=change-me

# Vercel sets this automatically in deployments.
VERCEL=0
