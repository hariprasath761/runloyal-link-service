{
    "version": 2,
    "buildCommand": "npm run admin:build",
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": [
                "admin-dist/**",
                "src/**",
                "public/**",
                "data/**"
            ]
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.js"
        }
    ]
}